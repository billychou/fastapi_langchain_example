# ============ 应用 ============
APP_ENV=dev                 # dev / staging / production
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# ============ MySQL 8.0 ============
DATABASE_URL=mysql+aiomysql://auth_user:CHANGE_ME@127.0.0.1:3306/auth_service?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ============ Redis ============
REDIS_URL=redis://127.0.0.1:6379/0

# ============ JWT 双 Token ============
# 生产必填: openssl rand -base64 48 ; 多服务互验建议 RS256 非对称
JWT_SECRET_KEY=REPLACE_WITH_openssl_rand_base64_48
JWT_ALGORITHM=HS256
JWT_ISSUER=auth-service
ACCESS_TOKEN_TTL_SECONDS=900        # Access 15 分钟
REFRESH_TOKEN_TTL_SECONDS=2592000   # Refresh 30 天
REFRESH_TOKEN_ROTATION=true         # 刷新即轮换(强烈推荐)
STRICT_SESSION_CHECK=true           # Access 校验时查 Redis 会话(踢人即时生效)

# ============ 登录策略 ============
LOGIN_POLICY_DEFAULT=multi_device   # multi_device | single_device
REGISTER_REQUIRE_SMS=false          # 注册是否强制短信验证码

# ============ Argon2id (OWASP 推荐) ============
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

# ============ 限流(令牌桶) ============
RL_LOGIN_IP_CAPACITY=10
RL_LOGIN_IP_REFILL_PER_MIN=5
RL_LOGIN_ACCOUNT_CAPACITY=5
RL_LOGIN_ACCOUNT_REFILL_PER_MIN=2
RL_SMS_PER_MINUTE=1
RL_SMS_PER_DAY=10

# ============ 登录失败锁定 ============
LOGIN_MAX_FAILURES=5
LOGIN_FAIL_WINDOW_SECONDS=600
LOGIN_LOCK_BASE_SECONDS=900
LOGIN_LOCK_MAX_SECONDS=86400
LOGIN_CAPTCHA_THRESHOLD=3

# ============ RBAC 权限缓存 ============
RBAC_CACHE_TTL_SECONDS=300

# ============ PII 字段加密 ============
# 密钥生成: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# 多版本逗号分隔, 轮转时保留旧版本; 以下为 DEMO 占位值, 生产必须全部替换
PII_ACTIVE_KEY_ID=k1
PII_KEYS=k1:WnM9vicjEZwds16p/bvI3Ywaci4PKMEBl/tZVUl9Flc=,k2:n5QGr8jgOA1i+kZOGk03LgpL8eeEJ2tB5SZrJNb1tAw=
PII_BLIND_INDEX_KEY=+Uj2zvu1ySBJ30/L5+YoPZxUWLztWyqhDKgu2aYh21s=
