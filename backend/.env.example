# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your values.
# ---------------------------------------------------------------------------

# ================= 应用 =================
APP_ENV=dev                 # dev / staging / production
DEBUG=true
# 日志格式: auto=dev 人类可读 / production 单行 JSON; 可强制 text|json
LOG_FORMAT=auto
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ================= LLM (聊天 Agent) =================
# Provider: "openai" (兼容 DeepSeek / Moonshot / Ollama), "anthropic", "mock"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
# 单次 LLM 请求超时秒数(含流式), 防上游挂死拖住 SSE 连接
LLM_TIMEOUT_SECONDS=60
SYSTEM_PROMPT=你是一个乐于助人的智能助理。你可以查询当前时间、做数学计算、查询示例天气。请用中文回答，回答尽量简洁清晰。
# /api/chat 是否要求登录(企业默认 true; 无 Redis/MySQL 的纯演示可临时置 false)
CHAT_REQUIRE_AUTH=true
# LangGraph checkpointer: sqlite(默认, 零依赖) 或 postgres(生产多副本)
CHECKPOINT_BACKEND=sqlite
# sqlite 后端时的本地文件路径(相对 backend/ 运行目录)
CHECKPOINT_DB_PATH=./agent_checkpoints.sqlite
# postgres 后端时必填; checkpoint_* 表首次启动自动创建
# CHECKPOINT_DATABASE_URL=postgres://langgraph:CHANGE_ME@127.0.0.1:5432/langgraph

# ================= Agent 技能(skills) =================
# 技能 = SKILLS_DIR 下的一个目录(SKILL.md frontmatter+正文, 可选 references/ 附件);
# 三级渐进披露: 目录常驻系统提示 → load_skill 取正文 → read_skill_file 取附件。
# 改磁盘上的技能目录即时生效(按 SKILL.md mtime 指纹惰性重扫), 无需重启。详见 docs/skills-design.md
SKILLS_ENABLED=true
SKILLS_DIR=./skills          # 相对 backend/ 运行目录; 生产建议配绝对路径
SKILL_MAX_CATALOG_CHARS=2000 # L1 目录注入系统提示的字符上限
SKILL_MAX_BODY_CHARS=8000    # L2 SKILL.md 正文交给模型的上限
SKILL_MAX_FILE_BYTES=262144  # L3 单个附件的字节上限
SKILL_MAX_FILES_PER_SKILL=100

# ================= 聊天接口保护 =================
CHAT_MAX_MESSAGES=100          # 单次请求消息条数上限
CHAT_MAX_MESSAGE_CHARS=32000   # 单条消息字符数上限
RL_CHAT_CAPACITY=10            # 聊天令牌桶容量(登录按账号/匿名按 IP)
RL_CHAT_REFILL_PER_MIN=6.0     # 每分钟恢复令牌数
# 可信代理跳数: 0=只信直连; 部署在 Nginx/LB 后设为 1, 限流/审计 IP
# 将按 X-Forwarded-For 从右向左解析(错误配置会导致风控失效)
TRUSTED_PROXY_HOPS=0

# ================= MySQL 8.0 (认证系统) =================
# 本地开发: docker compose up -d 后使用下面默认值
DATABASE_URL=mysql+aiomysql://auth_user:auth_pass_dev@127.0.0.1:3306/auth_service?charset=utf8mb4

# ================= Redis =================
REDIS_URL=redis://127.0.0.1:6379/0

# ================= JWT 双 Token =================
# 生产必填: openssl rand -base64 48 (APP_ENV=production 时缺失/占位值将拒绝启动)
JWT_SECRET_KEY=REPLACE_WITH_openssl_rand_base64_48
JWT_ALGORITHM=HS256
JWT_ISSUER=auth-service
ACCESS_TOKEN_TTL_SECONDS=900        # Access 15 分钟
REFRESH_TOKEN_TTL_SECONDS=2592000   # Refresh 30 天
REFRESH_TOKEN_ROTATION=true
STRICT_SESSION_CHECK=true

# ================= 登录策略与风控 =================
LOGIN_POLICY_DEFAULT=multi_device   # multi_device | single_device
REGISTER_REQUIRE_SMS=false
LOGIN_MAX_FAILURES=5
LOGIN_CAPTCHA_THRESHOLD=3

# ================= PII 字段加密 =================
# 密钥生成: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# 以下为 DEMO 占位值, 生产必须全部替换(生产环境复用会被启动校验拦截)
PII_ACTIVE_KEY_ID=k1
PII_KEYS=k1:WnM9vicjEZwds16p/bvI3Ywaci4PKMEBl/tZVUl9Flc=,k2:n5QGr8jgOA1i+kZOGk03LgpL8eeEJ2tB5SZrJNb1tAw=
PII_BLIND_INDEX_KEY=+Uj2zvu1ySBJ30/L5+YoPZxUWLztWyqhDKgu2aYh21s=
