# ---------------------------------------------------------------------------
# LLM provider configuration
# Copy this file to `.env` and fill in your values.
# ---------------------------------------------------------------------------

# Provider: "openai" (also works with any OpenAI-compatible API such as
# DeepSeek / Moonshot / Ollama via OPENAI_BASE_URL), "anthropic", or "mock"
# (no network calls, canned replies — handy for UI development).
# If no API key is configured the server automatically falls back to "mock".
LLM_PROVIDER=openai

# Model name, e.g.:
#   OpenAI:        gpt-4o-mini / gpt-4o
#   DeepSeek:      deepseek-chat
#   Anthropic:     claude-sonnet-4-20250514
#   Mock:          ignored
LLM_MODEL=gpt-4o-mini

# OpenAI / OpenAI-compatible providers
OPENAI_API_KEY=
# Optional custom endpoint (leave empty for api.openai.com):
#   DeepSeek: https://api.deepseek.com/v1
#   Ollama:   http://localhost:11434/v1
OPENAI_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=

# System prompt for the agent
SYSTEM_PROMPT=你是一个乐于助人的智能助理。你可以查询当前时间、做数学计算、查询示例天气。请用中文回答，回答尽量简洁清晰。

# Comma-separated list of allowed CORS origins for the frontend dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
